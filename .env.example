NEXUS_MODEL_PROVIDER=ollama
NEXUS_MODEL_NAME=qwen3:4b
NEXUS_OLLAMA_URL=http://localhost:11434
# Optional high-capability download (18 GB; requires substantially more RAM): qwen3.8:27b
# Online alternative: set NEXUS_MODEL_PROVIDER=gemini and provide the key only
# through your local environment or cloud secret manager.
NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_MODEL_NAME=gemini-3.7-flash
NEXUS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Free-first online alternatives. Each key remains optional and must be stored as a secret.
NEXUS_OPENROUTER_API_KEY=
NEXUS_OPENROUTER_MODEL_NAME=openrouter/free
NEXUS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NEXUS_GROQ_API_KEY=
NEXUS_GROQ_MODEL_NAME=openai/gpt-oss-120b
NEXUS_GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenAI's latest API models are paid and stay blocked unless explicitly enabled.
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_MODEL_NAME=gpt-5.6-luna
NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
NEXUS_ALLOW_PAID_MODELS=false
# Media generation. Pollinations uses account credits; OpenAI media remains paid-gated.
NEXUS_POLLINATIONS_API_KEY=
NEXUS_POLLINATIONS_BASE_URL=https://gen.pollinations.ai
NEXUS_MEDIA_STORAGE_PATH=data/media
NEXUS_MODEL_FALLBACK_ENABLED=true
NEXUS_MODEL_FALLBACKS=gemini,openrouter,groq
# Optional OpenAI-compatible endpoint. Unknown-cost endpoints require the paid switch.
NEXUS_COMPATIBLE_API_KEY=
NEXUS_COMPATIBLE_MODEL_NAME=
NEXUS_COMPATIBLE_BASE_URL=
NEXUS_COMPATIBLE_LABEL=Compatible API
NEXUS_COMPATIBLE_COST_TIER=unknown
# Provider keys pasted into the authenticated UI are encrypted at rest only when
# this contains a stable Fernet key. Generate it once and keep it secret.
NEXUS_PROVIDER_SECRET_ENCRYPTION_KEY=
# Comma-separated HTTPS hosts permitted for manually configured compatible APIs.
NEXUS_PROVIDER_ALLOWED_HOSTS=
NEXUS_OLLAMA_ENABLED=false
NEXUS_PUBLIC_URL=https://nexus-command-center-r3h8.onrender.com
NEXUS_DATABASE_PATH=data/nexus.db
# Online persistence: use the pooled Neon URL. When set, this takes precedence.
NEXUS_DATABASE_URL=
NEXUS_PROJECT_ROOT=.
# JSON only references secret environment names; never place tokens in this value.
NEXUS_MCP_SERVERS=[{"name":"openai-docs","transport":"streamable_http","endpoint":"https://developers.openai.com/mcp","read_only":true,"allowed_tools":["search_openai_docs","list_openai_docs","fetch_openai_doc","list_api_endpoints","get_openapi_spec"]},{"name":"github","transport":"streamable_http","endpoint":"https://api.githubcopilot.com/mcp/x/repos/readonly","auth_env":"NEXUS_GITHUB_TOKEN","read_only":true,"allowed_tools":["get_file_contents","search_code","list_branches","get_commit"]}]
NEXUS_GITHUB_TOKEN=
NEXUS_GITHUB_REPOSITORY=
NEXUS_VOICE_STT_PROVIDER=browser
NEXUS_VOICE_TTS_PROVIDER=browser
NEXUS_VOICE_MODEL=base
NEXUS_AUTOMATION_ENABLED=true
# Required for public deployment. Generate a high-entropy value and store it as
# a cloud secret; leave empty only for trusted local development.
NEXUS_ACCESS_TOKEN=
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEXUS_SERVE_FRONTEND=false
NEXUS_FRONTEND_DIST_PATH=frontend/dist
